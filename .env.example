# Copy this file to .env and fill in your key. Never commit .env.

# Claude (required) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI embeddings (optional) — https://dashboard.voyageai.com/
# Only needed for the code pre-screen on large codebooks and for `qual search`.
# Leave this line commented out to run with the Anthropic key alone.
# VOYAGE_API_KEY=pa-...
